# Keep the graph to the site's own source. .gitignore already drops the
# baked data; these are tracked but are not our code, or are frozen copies.
**/vendor/
**/node_modules/
**/*.min.js
page_backups/
_design-mockups/
graphify-out/
# The GALES solver's bundled third-party libraries (CMake's own manual,
# Trilinos): 2,100 HTML pages that are not GeoID's and would swamp the
# site's ~40 real pages in the graph.
GeoID_GIS/gales/tpl/
